# Riot API (https://developer.riotgames.com). Dev keys expire every 24 hours.
RIOT_API_KEY=
RIOT_PLATFORM=na1
RIOT_REGION=americas

# App rate limits as requests:seconds pairs, enforced per routing host.
# Copy from the X-App-Rate-Limit response header for your key.
RIOT_RATE_LIMITS=20:1,100:120

# Local paths
EKKO_DATA_DIR=data
EKKO_DUCKDB_PATH=data/ekko.duckdb

# MotherDuck (optional until the cloud warehouse is set up)
MOTHERDUCK_TOKEN=

# Claude API for the AI coach (Phase 7)
ANTHROPIC_API_KEY=
